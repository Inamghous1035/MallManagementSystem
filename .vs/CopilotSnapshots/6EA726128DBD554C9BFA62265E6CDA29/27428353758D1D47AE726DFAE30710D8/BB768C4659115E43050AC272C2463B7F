@model MallManagementSystem.Models.Sale

@{
    ViewData["Title"] = "Bill Receipt";
}

<style>
    @@media print {
        body {
            margin: 0;
            padding: 10px;
        }
        .container {
            margin: 0;
            padding: 0;
            width: 100%;
        }
        .no-print {
            display: none !important;
        }
        .card {
            box-shadow: none !important;
            border: 1px solid #333 !important;
        }
        .btn {
            display: none;
        }
    }

    .receipt-container {
        font-family: 'Courier New', monospace;
        max-width: 400px;
        margin: 20px auto;
    }

    .receipt-header {
        text-align: center;
        border-bottom: 2px solid #333;
        padding-bottom: 10px;
        margin-bottom: 15px;
    }

    .receipt-header h4 {
        margin: 0;
        font-size: 18px;
        font-weight: bold;
    }

    .receipt-header small {
        display: block;
        font-size: 12px;
        color: #666;
    }

    .receipt-info {
        font-size: 13px;
        margin-bottom: 15px;
    }

    .receipt-info p {
        margin: 5px 0;
        display: flex;
        justify-content: space-between;
    }

    .receipt-items {
        border-top: 2px solid #333;
        border-bottom: 2px solid #333;
        padding: 10px 0;
        margin: 15px 0;
    }

    .receipt-items table {
        width: 100%;
        font-size: 12px;
        border-collapse: collapse;
    }

    .receipt-items th {
        text-align: left;
        font-weight: bold;
        padding: 5px 0;
        border-bottom: 1px solid #999;
    }

    .receipt-items td {
        padding: 6px 0;
        text-align: left;
    }

    .receipt-items td:nth-child(2),
    .receipt-items td:nth-child(3),
    .receipt-items td:nth-child(4) {
        text-align: right;
    }

    .receipt-items th:nth-child(2),
    .receipt-items th:nth-child(3),
    .receipt-items th:nth-child(4) {
        text-align: right;
    }

    .receipt-total {
        text-align: right;
        margin: 15px 0;
        font-size: 14px;
    }

    .receipt-total h5 {
        margin: 0;
        font-size: 16px;
        font-weight: bold;
        border-top: 2px solid #333;
        padding-top: 10px;
    }

    .receipt-actions {
        text-align: center;
        margin-top: 20px;
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .print-btn {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 14px;
        transition: background-color 0.3s;
    }

    .print-btn:hover {
        background-color: #218838;
    }

    .btn-link {
        text-decoration: none;
    }

    .print-hint {
        text-align: center;
        font-size: 12px;
        color: #999;
        margin-top: 15px;
    }
</style>

<div class="receipt-container">
    <div class="receipt-header no-print">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">🏬 Mall Management System</h4>
                <small>Sale Receipt</small>
            </div>
        </div>
    </div>

    <!-- Bill Content (Print-friendly) -->
    <div class="card receipt-card" style="max-width: 400px; margin: 0 auto;">
        <div class="receipt-header" style="padding: 15px; border-bottom: 2px solid #333;">
            <h4 class="mb-0">🏬 MALL MANAGEMENT SYSTEM</h4>
            <small>SALE RECEIPT</small>
        </div>

        <div style="padding: 15px;">
            <div class="receipt-info">
                <p><strong>Bill No:</strong> <span>#@Model.SaleId</span></p>
                <p><strong>Date & Time:</strong> <span>@Model.SaleDate.ToString("dd-MM-yyyy hh:mm tt")</span></p>
            </div>

            <div class="receipt-items">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 40%;">Product</th>
                            <th style="width: 15%;">Qty</th>
                            <th style="width: 20%;">Price</th>
                            <th style="width: 25%;">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.SaleItems != null && Model.SaleItems.Any())
                        {
                            @foreach (var item in Model.SaleItems)
                            {
                                decimal subtotal = item.Quantity * item.Price;
                                <tr>
                                    <td>@item.Product?.Name</td>
                                    <td>@item.Quantity</td>
                                    <td>Rs. @item.Price.ToString("F2")</td>
                                    <td>Rs. @subtotal.ToString("F2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="receipt-total">
                <h5>Total Amount: Rs. @Model.TotalAmount.ToString("F2")</h5>
            </div>

            <div style="text-align: center; font-size: 12px; margin: 15px 0; border-top: 1px solid #999; padding-top: 10px;">
                <p style="margin: 5px 0;">Thank you for your purchase!</p>
                <p style="margin: 5px 0; color: #666;">Please visit again</p>
            </div>

            <div class="receipt-actions no-print">
                <button class="print-btn" onclick="window.print()">🖨️ Print Receipt</button>
                <a asp-action="Create" class="btn btn-outline-secondary">⬅️ New Bill</a>
                <a asp-action="Index" asp-controller="Products" class="btn btn-primary">📦 Inventory</a>
            </div>

            <div class="print-hint no-print">
                💡 Press Ctrl+P or click Print to print this receipt
            </div>
        </div>
    </div>
</div>