@model IEnumerable<MallManagementSystem.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📦 Products Inventory</h2>
        <a asp-action="Create" class="btn btn-success">+ Add New Product</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price (Rs.)</th>
                        <th>Quantity</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td><span class="badge bg-secondary">@item.Category</span></td>
                            <td>@item.Price</td>
                            <td>
                                @if (item.Quantity < 10)
                                {
                                    <span class="text-danger fw-bold">@item.Quantity (Low Stock)</span>
                                }
                                else
                                {
                                    <span>@item.Quantity</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <p class="text-center text-muted">Koi product available nahi hai. "Add New Product" pe click karke shuru karein.</p>
            }
        </div>
    </div>
</div>