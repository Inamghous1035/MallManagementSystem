@model MallManagementSystem.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <h1>✏️ Edit User: @Model.Username</h1>

            <form method="post">
                <input type="hidden" name="id" value="@Model.UserId" />

                <div class="form-group mb-3">
                    <label class="form-label">Username</label>
                    <input type="text" class="form-control" value="@Model.Username" disabled>
                    <small class="form-text text-muted">Username cannot be changed</small>
                </div>

                <div class="form-group mb-3">
                    <label for="role" class="form-label">Role</label>
                    <select class="form-control" id="role" name="role" required>
                        @foreach (var roleOption in ViewBag.Roles)
                        {
                            if (Model.Role == roleOption)
                            {
                                <option value="@roleOption" selected>@roleOption</option>
                            }
                            else
                            {
                                <option value="@roleOption">@roleOption</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">💾 Update User</button>
                    <a asp-action="Index" class="btn btn-secondary">⬅️ Back</a>
                </div>
            </form>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mt-3">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>
