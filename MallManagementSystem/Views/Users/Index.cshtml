@model List<MallManagementSystem.Models.User>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>👥 User Management</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-success">➕ Add New User</a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>User ID</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td><strong>#@user.UserId</strong></td>
                            <td>@user.Username</td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-danger">@user.Role</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">@user.Role</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-warning">✏️ Edit</a>
                                <a asp-action="Delete" asp-route-id="@user.UserId" class="btn btn-sm btn-danger">🗑️ Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <strong>No users found.</strong> <a asp-action="Create" class="alert-link">Create the first user</a>.
        </div>
    }
</div>
