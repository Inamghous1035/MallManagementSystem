@model MallManagementSystem.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-5">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-1">📊 Dashboard</h1>
            <p class="text-muted">Welcome back! Here's your business overview for today.</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <!-- Total Products in Stock -->
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">📦 Total Products</h5>
                    <h2 class="mb-0">@Model.TotalProductsInStock</h2>
                    <small class="text-light">Units in stock</small>
                </div>
            </div>
        </div>

        <!-- Total Sales Today -->
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">🛒 Sales Today</h5>
                    <h2 class="mb-0">@Model.TotalSalesToday</h2>
                    <small class="text-light">Transactions</small>
                </div>
            </div>
        </div>

        <!-- Total Revenue Today -->
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">💰 Revenue Today</h5>
                    <h2 class="mb-0">Rs. @Model.TotalRevenueToday.ToString("F2")</h2>
                    <small class="text-light">Total earnings</small>
                </div>
            </div>
        </div>

        <!-- Low Stock Alert -->
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">⚠️ Low Stock</h5>
                    <h2 class="mb-0">@Model.LowStockProducts.Count</h2>
                    <small class="text-light">Products</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Low Stock Alert Section -->
    @if (Model.LowStockProducts.Any())
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card border-warning shadow-sm">
                    <div class="card-header bg-warning text-white">
                        <h5 class="mb-0">⚠️ Low Stock Alert</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product Name</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Current Stock</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model.LowStockProducts)
                                    {
                                        <tr>
                                            <td><strong>@product.Name</strong></td>
                                            <td>@product.Category</td>
                                            <td>Rs. @product.Price.ToString("F2")</td>
                                            <td>
                                                <span class="badge bg-danger">@product.Quantity</span>
                                            </td>
                                            <td>
                                                @if (product.Quantity <= 5)
                                                {
                                                    <span class="badge bg-danger">Critical</span>
                                                }
                                                else if (product.Quantity < 10)
                                                {
                                                    <span class="badge bg-warning">Reorder Soon</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <strong>✅ All Good!</strong> All products have sufficient stock levels.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    }

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">⚡ Quick Actions</h5>
                </div>
                <div class="card-body">
                    <a asp-controller="Sales" asp-action="Create" class="btn btn-primary">➕ Create New Sale</a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">📦 View Products</a>
                    <a asp-controller="Sales" asp-action="Index" class="btn btn-info">📊 Sales History</a>
                </div>
            </div>
        </div>
    </div>
</div>

