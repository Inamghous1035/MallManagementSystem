@model MallManagementSystem.Models.Sale

@{
    ViewData["Title"] = "Bill Receipt";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white text-center">
                    <h4 class="mb-0">🧾 Mall Management System</h4>
                    <small>Sale Receipt</small>
                </div>
                <div class="card-body">
                    <p><strong>Bill No:</strong> @Model.SaleId</p>
                    <p><strong>Date:</strong> @Model.SaleDate.ToString("dd-MM-yyyy hh:mm tt")</p>

                    <hr />

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Qty</th>
                                <th>Price</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SaleItems)
                            {
                                <tr>
                                    <td>@item.Product?.Name</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.Price</td>
                                    <td>@(item.Quantity * item.Price)</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <hr />

                    <h5 class="text-end">Total: Rs. @Model.TotalAmount</h5>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Create" class="btn btn-outline-secondary">← New Bill</a>
                        <a asp-action="Index" asp-controller="Products" class="btn btn-primary">Go to Inventory</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>